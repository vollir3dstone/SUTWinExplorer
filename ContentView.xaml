<UserControl x:Class="SUTWinExplorer.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SUTWinExplorer">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="HeaderArea" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ViewControlsRow" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource BadgeStyle}"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="VIEW:" FontWeight="Bold" Foreground="#4E5963"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer x:Name="ViewControlsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <TextBlock TextWrapping="NoWrap">
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:CheckBoxWrapper x:Name="HideDirectoriesCheckBox"
                                                   Label="Hide directories" Margin="0,0,16,0" />
                        </InlineUIContainer>
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:CheckBoxWrapper x:Name="HideInternalContentCheckBox"
                                                   Label="Hide internal" Margin="0,0,16,0" />
                        </InlineUIContainer>
                        <Run Text="Name pattern  " />
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <Border Width="172" Height="24"
                                    local:InputChrome.BaselineSource="{Binding ElementName=NamePatternTextBox}"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{StaticResource Input.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource InputCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NamePatternTextBox" Grid.Column="0" Padding="3,0"
                                             local:InputChrome.CornerRadius="3,0,0,3"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Use * and ? as wildcards"
                                             TextChanged="NamePatternTextBox_TextChanged" />
                                    <Button Grid.Column="1" Content="×" Style="{StaticResource ContentPaneButtonStyle}"
                                            Width="20" Height="22" Padding="0"
                                            local:InputChrome.CornerRadius="0,3,3,0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="Clear name pattern" Click="ClearNamePatternButton_Click" />
                                </Grid>
                            </Border>
                        </InlineUIContainer>
                        <Run Text="  Sort order  " />
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:SortOrderWidget x:Name="SortOrderEditor"
                                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                        </InlineUIContainer>
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <Button x:Name="ResetViewButton" Style="{StaticResource ContentPaneButtonStyle}"
                                    Margin="16,0,0,0" ToolTip="Reset content filters and sort order"
                                    Click="ResetViewButton_Click">
                                <TextBlock x:Name="ResetViewLabel" Text="Reset" />
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    </ScrollViewer>
                </Grid>
            <Grid x:Name="SelectionControlsRow" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource BadgeStyle}" Margin="0,0,8,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="FOR SELECTED:" FontWeight="Bold" Foreground="#4E5963" VerticalAlignment="Center" />
                </Border>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PropertiesButton" Content="Properties…" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Properties" ToolTip="Properties"
                            Tag="Properties" Width="72" Padding="0" IsEnabled="False" Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="ClipboardCopyButtons" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="NameClipboardCopyButton" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Name clipboard copy" ToolTip="Name clipboard copy"
                            Tag="NameClipboardCopy" Width="54" Margin="0" Padding="0" local:InputChrome.CornerRadius="3,0,0,3" IsEnabled="False"
                                Click="ContentOperationButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Name" VerticalAlignment="Center" /><Control Width="14" Height="14" Margin="2,0,0,0" Template="{StaticResource ClipboardCopyIconTemplate}" /></StackPanel>
                        </Button>
                        <Button x:Name="PathClipboardCopyButton" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Path clipboard copy" ToolTip="Path clipboard copy"
                            Tag="PathClipboardCopy" Width="48" Margin="0" Padding="0" BorderThickness="0,1,1,1" local:InputChrome.CornerRadius="0" IsEnabled="False"
                                Click="ContentOperationButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Path" VerticalAlignment="Center" /><Control Width="14" Height="14" Margin="2,0,0,0" Template="{StaticResource ClipboardCopyIconTemplate}" /></StackPanel>
                        </Button>
                        <Button x:Name="ItemClipboardCopyButton" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Item clipboard copy" ToolTip="Item clipboard copy"
                            Tag="ItemClipboardCopy" Width="48" Margin="0" Padding="0" BorderThickness="0,1,1,1" local:InputChrome.CornerRadius="0,3,3,0" IsEnabled="False" Click="ContentOperationButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Item" VerticalAlignment="Center" /><Control Width="14" Height="14" Margin="2,0,0,0" Template="{StaticResource ClipboardCopyIconTemplate}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="TransferMarkItemButtons" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Button x:Name="LinkMarkItemButton" Content="Link🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Link mark item" ToolTip="Link mark item"
                            Tag="LinkMarkItem" Width="48" Margin="0" Padding="0" local:InputChrome.CornerRadius="3,0,0,3" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="CopyMarkItemButton" Content="Copy🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy mark item" ToolTip="Copy mark item"
                            Tag="CopyMarkItem" Width="48" Margin="0" Padding="0" BorderThickness="0,1,1,1" local:InputChrome.CornerRadius="0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="MoveMarkItemButton" Content="Move🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move mark item" ToolTip="Move mark item"
                            Tag="MoveMarkItem" Width="48" Margin="0" Padding="0" BorderThickness="0,1,1,1" local:InputChrome.CornerRadius="0,3,3,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                        <Button x:Name="RenameButton" Content="Rename…" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Rename" ToolTip="Rename"
                            Tag="Rename" Width="72" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="9" Orientation="Horizontal">
                        <Button x:Name="DeleteButton" Content="Del🗑️" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Delete" ToolTip="Delete"
                            Tag="Delete" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
            <Grid x:Name="DirectoryActions" Grid.Row="1" Grid.Column="0" Margin="4,0,8,0" MinWidth="72">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="DirectoryHeading" Grid.Row="0">
                    <Border x:Name="DirectoryBadge" Style="{StaticResource BadgeStyle}">
                        <TextBlock Text="DIRECTORY" FontWeight="Bold" Foreground="#4E5963" TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Grid Margin="0,4,0,0" HorizontalAlignment="Center" ToolTip="Unfiltered items in this directory">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DirectoryCountLabel" Text="-" TextAlignment="Right" Foreground="#596675" />
                        <TextBlock Grid.Column="1" Text=" subdir." Foreground="#596675" />
                        <TextBlock x:Name="FileCountLabel" Grid.Row="1" Text="-" TextAlignment="Right" Foreground="#596675" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=" files" Foreground="#596675" />
                    </Grid>
                    <TextBlock x:Name="StatusLabel" Foreground="#A12727" HorizontalAlignment="Center" />
                </StackPanel>
                <Grid x:Name="DirectoryButtonGroup" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="4" />
                    </Grid.RowDefinitions>
                <Button x:Name="NewButton" Grid.Row="1" Content="New…" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="New" ToolTip="New"
                        Tag="New" Width="Auto" HorizontalAlignment="Stretch" Padding="0" IsEnabled="False" Click="ContentOperationButton_Click" />
                <Button x:Name="ItemClipboardPasteButton" Grid.Row="3" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Item clipboard paste" ToolTip="Item clipboard paste"
                    Tag="ItemClipboardPaste" Width="Auto" HorizontalAlignment="Stretch" Padding="0" IsEnabled="False" Click="ContentOperationButton_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Item" VerticalAlignment="Center" /><Control Width="14" Height="14" Margin="2,0,0,0" Template="{StaticResource ClipboardPasteIconTemplate}" /></StackPanel>
                </Button>
                <StackPanel x:Name="LinkTransferButtons" Grid.Row="5" Visibility="Collapsed">
                    <Button x:Name="LinkAbortButton" Content="Link✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Link abort" ToolTip="Link abort"
                        Tag="LinkAbort" Width="Auto" HorizontalAlignment="Stretch" Padding="0" Margin="0,0,0,4" IsEnabled="False" Click="ContentOperationButton_Click" />
                    <Button x:Name="LinkExecuteButton" Content="Link🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Link execute" ToolTip="Link execute"
                        Tag="LinkExecute" Width="Auto" HorizontalAlignment="Stretch" Padding="0" IsEnabled="False" Click="ContentOperationButton_Click" />
                </StackPanel>
                <StackPanel x:Name="CopyTransferButtons" Grid.Row="7" Visibility="Collapsed">
                    <Button x:Name="CopyAbortButton" Content="Copy✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy abort" ToolTip="Copy abort"
                        Tag="CopyAbort" Width="Auto" HorizontalAlignment="Stretch" Padding="0" Margin="0,0,0,4" IsEnabled="False" Click="ContentOperationButton_Click" />
                    <Button x:Name="CopyExecuteButton" Content="Copy🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy execute" ToolTip="Copy execute"
                        Tag="CopyExecute" Width="Auto" HorizontalAlignment="Stretch" Padding="0" IsEnabled="False" Click="ContentOperationButton_Click" />
                </StackPanel>
                <StackPanel x:Name="MoveTransferButtons" Grid.Row="9" Visibility="Collapsed">
                    <Button x:Name="MoveAbortButton" Content="Move✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move abort" ToolTip="Move abort"
                        Tag="MoveAbort" Width="Auto" HorizontalAlignment="Stretch" Padding="0" Margin="0,0,0,4" IsEnabled="False" Click="ContentOperationButton_Click" />
                    <Button x:Name="MoveExecuteButton" Content="Move🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move execute" ToolTip="Move execute"
                        Tag="MoveExecute" Width="Auto" HorizontalAlignment="Stretch" Padding="0" IsEnabled="False" Click="ContentOperationButton_Click" />
                </StackPanel>
                </Grid>
            </Grid>
            <ListView x:Name="FileList" Grid.Row="1" Grid.Column="1" SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="FileList_SelectionChanged" SizeChanged="FileList_SizeChanged"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="FileList_PreviewMouseButtonUp"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      GridViewColumnHeader.Click="FileList_ColumnHeaderClick"
                      PreviewKeyDown="FileList_PreviewKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                                                        <Grid Background="Transparent" ToolTipService.InitialShowDelay="500"
                                                                                    ToolTipService.ShowDuration="30000" ToolTipOpening="RowToolTip_Opening"
                                                                                    SizeChanged="RowToolTip_SizeChanged">
                                        <Grid.ToolTip>
                                                                                        <ToolTip Placement="Bottom">
                                                                                                <TextBlock Text="{Binding PlacementTarget.DataContext.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Border x:Name="RowBackground" IsHitTestVisible="False" />
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource ItemSelectionBrush}" />
                                            <Setter TargetName="RowBackground" Property="BorderBrush" Value="{StaticResource ItemSelectionBorderBrush}" />
                                            <Setter TargetName="RowBackground" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn x:Name="MediaTypeIcon" Width="30">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="MediaTypeIcon" Padding="1,0" ToolTip="Sort by media type" Loaded="FileList_HeaderLoaded">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="MT" /><TextBlock x:Name="MediaTypeIconSortIndicator" Visibility="Collapsed" Margin="1,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                     <Image Width="16" Height="16" Source="{Binding Entry.MediaTypeIcon}"
                                         AutomationProperties.Name="{Binding Entry.MediaTypeName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="MediaTypeSubTypeColumn" Width="30">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Padding="1,0" ToolTip="Media type sub type" Loaded="FileList_HeaderLoaded">
                                    <TextBlock Text="ST" />
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                     <Image Width="16" Height="16" Source="{Binding Entry.MediaTypeSubTypeIcon}"
                                         AutomationProperties.Name="{Binding Entry.MediaTypeSubTypeName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ModifierIconColumn" Width="32">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Padding="1,0" ToolTip="Modifier icon" Loaded="FileList_HeaderLoaded">
                                    <TextBlock Text="MO" />
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16" Height="16" Source="{Binding OverlayIcon}" Stretch="Uniform"
                                           Opacity="{Binding Entry.Icons.Opacity, TargetNullValue=1, FallbackValue=1}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="NameColumn" Width="330">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" ToolTip="Sort by name" Loaded="FileList_HeaderLoaded">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Name" /><TextBlock x:Name="NameSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="ItemName" Text="{Binding Entry.Name}" Foreground="Black" TextTrimming="CharacterEllipsis" />
                                        <TextBox x:Name="ItemNameEditor" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="Collapsed" Padding="1,0" MinWidth="80"
                                                 IsVisibleChanged="ItemNameEditor_IsVisibleChanged"
                                                 KeyDown="ItemNameEditor_KeyDown"
                                                 LostKeyboardFocus="ItemNameEditor_LostKeyboardFocus" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="ItemName" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ItemNameEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="TypeApp1Icon" Width="36">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="TypeApp1Icon" Padding="1,0" ToolTip="Sort by TA1 (type and/or default app, coarse)" Loaded="FileList_HeaderLoaded">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="TA1" /><TextBlock x:Name="TypeApp1IconSortIndicator" Visibility="Collapsed" Margin="1,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16" Height="16" Source="{Binding Entry.Icons.BaseIcon}" Stretch="None"
                                           Opacity="{Binding Entry.Icons.Opacity, TargetNullValue=1, FallbackValue=1}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="RightColumnsToggleColumn" Width="14">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader x:Name="RightColumnsToggleHeader" Padding="0" ToolTip="Hide right columns"
                                                      AutomationProperties.Name="Hide right columns" Click="RightColumnsToggle_Click">
                                    <GridViewColumnHeader.Template>
                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                            <Border x:Name="ToggleBackground" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBackground" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </GridViewColumnHeader.Template>
                                    <TextBlock x:Name="RightColumnsToggleSymbol" Text="▸" FontSize="11" />
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><Border /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="TypeApp2Name" Width="130">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="TypeApp2Name" ToolTip="Sort by TA2 (type and/or default app, fine)" Loaded="FileList_HeaderLoaded">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="TA2" /><TextBlock x:Name="TypeApp2NameSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Entry.Type}" Foreground="#666666" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="SizeColumn" Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" ToolTip="Sort by size" Loaded="FileList_HeaderLoaded">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Size" /><TextBlock x:Name="SizeSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Entry.SizeText}" Foreground="#666666"
                                                         HorizontalAlignment="Stretch" TextAlignment="Right" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="DateColumn" Width="130">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="DateModified" ToolTip="Sort by date modified" Loaded="FileList_HeaderLoaded">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Date modified" /><TextBlock x:Name="DateSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Entry.ModifiedText}" Foreground="#666666" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>
</UserControl>
