<UserControl x:Class="SUTWinExplorer.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SUTWinExplorer">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="24" Background="#E1E4E7" Padding="6,0"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="VIEW:" FontWeight="Bold" Foreground="#4E5963"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" TextWrapping="NoWrap">
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:CheckBoxWrapper x:Name="HideDirectoriesCheckBox"
                                                   Label="Hide directories" Margin="0,0,16,0" />
                        </InlineUIContainer>
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:CheckBoxWrapper x:Name="HideInternalContentCheckBox"
                                                   Label="Hide internal" Margin="0,0,16,0" />
                        </InlineUIContainer>
                        <Run Text="Name pattern  " />
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <Border Width="172" Height="24"
                                    local:InputChrome.BaselineSource="{Binding ElementName=NamePatternTextBox}"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{StaticResource Input.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource InputCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NamePatternTextBox" Grid.Column="0" Padding="3,0"
                                             local:InputChrome.CornerRadius="3,0,0,3"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Use * and ? as wildcards"
                                             TextChanged="NamePatternTextBox_TextChanged" />
                                    <Button Grid.Column="1" Content="×" Style="{StaticResource ContentPaneButtonStyle}"
                                            Width="20" Height="22" Padding="0"
                                            local:InputChrome.CornerRadius="0,3,3,0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="Clear name pattern" Click="ClearNamePatternButton_Click" />
                                </Grid>
                            </Border>
                        </InlineUIContainer>
                    </TextBlock>
                </Grid>
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#E1E4E7" Padding="6,3" Margin="0,0,8,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="FOR SELECTED:" FontWeight="Bold" Foreground="#4E5963" />
                </Border>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RenameButton" Content="Rename" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Rename" ToolTip="Rename"
                            Tag="Rename" Width="72" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="PathGetButton" Content="Path🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Path get" ToolTip="Path get"
                            Tag="PathGet" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="CopyGetButton" Content="Copy🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy get" ToolTip="Copy get"
                            Tag="CopyGet" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="CopyAbortButton" Content="Copy✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy abort" ToolTip="Copy abort"
                            Tag="CopyAbort" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="CopyPasteButton" Content="Copy🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy paste" ToolTip="Copy paste"
                            Tag="CopyPaste" Width="48" Padding="0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                        <Button x:Name="MoveGetButton" Content="Move🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move get" ToolTip="Move get"
                            Tag="MoveGet" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="MoveAbortButton" Content="Move✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move abort" ToolTip="Move abort"
                            Tag="MoveAbort" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="MovePasteButton" Content="Move🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move paste" ToolTip="Move paste"
                            Tag="MovePaste" Width="48" Padding="0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="9" Orientation="Horizontal">
                        <Button x:Name="DeleteButton" Content="Del🗑️" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Delete" ToolTip="Delete"
                            Tag="Delete" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ListView x:Name="FileList" Grid.Row="4" Grid.Column="0" SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      SelectionChanged="FileList_SelectionChanged" SizeChanged="FileList_SizeChanged"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      GridViewColumnHeader.Click="FileList_ColumnHeaderClick"
                      PreviewKeyDown="FileList_PreviewKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid Background="Transparent">
                                        <Border x:Name="RowBackground" IsHitTestVisible="False" />
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource ItemSelectionBrush}" />
                                            <Setter TargetName="RowBackground" Property="BorderBrush" Value="{StaticResource ItemSelectionBorderBrush}" />
                                            <Setter TargetName="RowBackground" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="42">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="MediaType" ToolTip="Sort by media type">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="MT" /><TextBlock x:Name="MediaTypeSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                     <Image Width="16" Height="16" Source="{Binding Entry.MediaTypeIcon}"
                                         AutomationProperties.Name="{Binding Entry.MediaTypeName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="34">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="ShellIcon" ToolTip="Sort by Shell icon">
                                    <TextBlock x:Name="IconSortIndicator" Visibility="Collapsed" FontSize="9" />
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16" Height="16" Source="{Binding Entry.Icons.BaseIcon}" Stretch="None"
                                           Opacity="{Binding Entry.Icons.Opacity, TargetNullValue=1, FallbackValue=1}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="26">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Overlay" ToolTip="Sort by Shell overlay">
                                    <TextBlock x:Name="OverlaySortIndicator" Visibility="Collapsed" FontSize="9" />
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16" Height="16" Source="{Binding Entry.Icons.OverlayIcon}" Stretch="Uniform"
                                           Opacity="{Binding Entry.Icons.Opacity, TargetNullValue=1, FallbackValue=1}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="330">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" ToolTip="Sort by name">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Name" /><TextBlock x:Name="NameSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="ItemName" Text="{Binding Entry.Name}" Foreground="Black" />
                                        <TextBox x:Name="ItemNameEditor" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="Collapsed" Padding="1,0" MinWidth="80"
                                                 IsVisibleChanged="ItemNameEditor_IsVisibleChanged"
                                                 KeyDown="ItemNameEditor_KeyDown"
                                                 LostKeyboardFocus="ItemNameEditor_LostKeyboardFocus" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="ItemName" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ItemNameEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="130">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Type" ToolTip="Sort by type">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Type" /><TextBlock x:Name="TypeSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Entry.Type}" Foreground="#666666" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="SizeColumn" Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" ToolTip="Sort by size">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Size" /><TextBlock x:Name="SizeSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Entry.SizeText}" Foreground="#666666"
                                                         HorizontalAlignment="Stretch" TextAlignment="Right" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="DateColumn" Width="130">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="DateModified" ToolTip="Sort by date modified">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Date modified" /><TextBlock x:Name="DateSortIndicator" Visibility="Collapsed" Margin="3,0,0,0" FontSize="9" /></StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Entry.ModifiedText}" Foreground="#666666" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E4E8" BorderThickness="1,0,0,0"
                    Background="#F6F7F8" VerticalAlignment="Stretch">
                <TextBlock x:Name="StatusLabel" Padding="8,6" Foreground="#596675"
                           VerticalAlignment="Top" HorizontalAlignment="Center" />
            </Border>
            </Grid>
</UserControl>
