{
	"types": [
		{
			"type": "executable",
			"extensions": [".exe", ".dll", ".msi"]
		},
		{
			"type": "box",
			"extensions": [".zip", ".7z", ".rar", ".tar", ".gz"]
		},
		{
			"type": "lines-text",
			"extensions": 
				{
					"text-based": [".txt", ".text"]
				}
		},
		{
			"type": "structured-data",
			"extensions": 
				{
					"text-based": [".xml", ".json", ".csv", ".tsv", ".yaml", ".yml", ".ini", ".cfg"],
					"app-specific": [".xlsx", ".xls", ".ods", ".mdb", ".accdb", ".sqlite", ".db", ".mdf", ".parquet"]
				}
		},
		{
			"type": "command-data",
			"extensions": 
				{
					"text-based": [
						".c", ".h", ".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx",
						".cs", ".java", ".kt", ".kts", ".swift", ".go", ".rs",
						".py", ".pyw", ".js", ".mjs", ".cjs", ".jsx", ".ts", ".mts",
						".cts", ".tsx", ".php", ".phtml", ".rb", ".pl", ".pm", ".r",
						".R", ".dart", ".scala", ".sc", ".lua", ".sh", ".bash", ".zsh",
						".bat", ".cmd", ".ps1", ".psm1", ".psd1", ".sql"
					]
				}
		},
		{
			"type": "book",
			"extensions": 
				{
					"render": [".pdf", ".ps", ".html", ".htm", ".mht", ".mhtm", ".mhtml", ".chm", ".msg", ".eps"],
					"edit": [".doc", ".docx", ".odt", ".rtf", ".md", ".pptx", ".ppt", ".vsd", ".vsdx", ".odg"]
				}
		},
		{
			"type": "image",
			"extensions": 
				{
					"render": [".jpg", ".jpeg", ".jpe", ".jp2", ".png", ".gif", ".bmp", ".tif", ".tiff", ".webp", ".avif", ".heic", ".ico"],
					"edit": [".svg", ".psd", ".xcf", ".wmf", ".emf", ".tga"]
				}
		},
		{
			"type": "audio",
			"extensions": {"render": [".wav", ".mp3", ".aac", ".flac", ".aiff", ".aif", ".m4a", ".m4b", ".weba", ".opus", ".wma", ".ogg", ".mid", ".midi"]}
		},
		{
			"type": "video",
			"extensions": {"render": [".mp4", ".m4v", ".mov", ".avi", ".wmv", ".mpg", ".mpeg", ".mkv", ".webm", ".ogv", ".ts", ".m2ts", ".3gp", ".flv"]}
		}
	]
}
