<UserControl x:Class="SUTWinExplorer.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Profiles" FontSize="16" FontWeight="SemiBold" Margin="8,8,8,12" />
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <ListBox x:Name="ProfileList" BorderBrush="{StaticResource ViewFrameBrush}"
                         SelectionChanged="ProfileList_SelectionChanged"
                         MouseDoubleClick="ProfileList_MouseDoubleClick"
                         KeyDown="ProfileList_KeyDown"
                         AutomationProperties.Name="Profiles" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DDE3" />
            <Grid Grid.Column="2" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"
                           Source="/Assets/profile 24.png" />
                    <TextBox Grid.Column="1" x:Name="ProfileNameEditor" Padding="4,1"
                             VerticalAlignment="Center" IsReadOnly="True"
                             AutomationProperties.Name="Selected profile name" />
                </Grid>
                <DataGrid Grid.Row="1" x:Name="PathviewsTable"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          BorderBrush="{StaticResource ViewFrameBrush}"
                          HorizontalGridLinesBrush="{StaticResource ViewFrameBrush}"
                          VerticalGridLinesBrush="{StaticResource ViewFrameBrush}"
                          AutomationProperties.Name="Profile Pathviews">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>