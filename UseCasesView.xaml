<UserControl x:Class="SUTWinExplorer.UseCasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,8,8,12">
            <TextBlock Text="Use cases" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="NewUseCaseButton" Content="New" Style="{StaticResource ContentPaneButtonStyle}"
                Padding="10,1" Margin="0,0,8,0" Click="NewUseCaseButton_Click" />
            <Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="FOR SELECTED:" FontWeight="Bold" Foreground="#4E5963" VerticalAlignment="Center" />
            </Border>
            <Button x:Name="EditUseCaseButton" Content="Edit" Style="{StaticResource ContentPaneButtonStyle}"
                Padding="10,1" Margin="0,0,8,0" Click="EditUseCaseButton_Click" />
            <Button x:Name="DeleteUseCaseButton" Content="Delete" Style="{StaticResource ContentPaneButtonStyle}"
                Padding="10,1" Click="DeleteUseCaseButton_Click" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <ListBox x:Name="UseCaseList" BorderBrush="{StaticResource ViewFrameBrush}"
                         SelectionChanged="UseCaseList_SelectionChanged"
                         MouseDoubleClick="UseCaseList_MouseDoubleClick"
                         KeyDown="UseCaseList_KeyDown"
                         AutomationProperties.Name="Use cases" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DDE3" />
            <Grid Grid.Column="2" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"
                           Source="/Assets/usecase 24.png" />
                    <TextBox Grid.Column="1" x:Name="UseCaseNameEditor" Padding="4,1"
                             VerticalAlignment="Center" IsReadOnly="True"
                             TextChanged="UseCaseNameEditor_TextChanged"
                             PreviewKeyDown="UseCaseNameEditor_PreviewKeyDown"
                             AutomationProperties.Name="Selected use case name" />
                </Grid>
                <DataGrid Grid.Row="1" x:Name="PathviewsTable"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          BorderBrush="{StaticResource ViewFrameBrush}"
                          HorizontalGridLinesBrush="{StaticResource ViewFrameBrush}"
                          VerticalGridLinesBrush="{StaticResource ViewFrameBrush}"
                          AutomationProperties.Name="Use case Pathviews">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>