<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>KIS Explorer</AssemblyTitle>
    <Product>KIS Explorer</Product>
    <Company>SUT</Company>
    <VersionFile>$(MSBuildProjectDirectory)\ReleaseDescription.txt</VersionFile>
    <InformationalVersion Condition="Exists('$(VersionFile)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(VersionFile)')), '[\r\n][\s\S]*$', '').Trim())</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="ValidateReleaseVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VersionFile)')" Text="ReleaseDescription.txt is missing. Add the version on its first line." />
    <Error Condition="'$(InformationalVersion)' == ''" Text="ReleaseDescription.txt must have a version on its first line." />
  </Target>

  <Target Name="ValidateMediaTypes" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\ValidateMediaTypes.ps1&quot; -Path &quot;$(MSBuildProjectDirectory)\Assets\media-types.json&quot;" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\net10.0-raw\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="NameApplicationHost" AfterTargets="_ComputeNETCoreBuildOutputFiles" BeforeTargets="AssignTargetPaths" Condition="'$(AppHostIntermediatePath)' != '' and '$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <None Update="$(AppHostIntermediatePath)">
        <Link>KIS Explorer.exe</Link>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="SetApplicationRunCommand" BeforeTargets="ComputeRunArguments" Condition="'$(UseAppHost)' == 'true' and '$(StartAction)' != 'Program'">
    <PropertyGroup>
      <RunCommand>$(TargetDir)KIS Explorer.exe</RunCommand>
    </PropertyGroup>
  </Target>

  <Target Name="NamePublishedApplication" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true' and Exists('$(PublishedSingleFilePath)')">
    <Move SourceFiles="$(PublishedSingleFilePath)" DestinationFiles="$(PublishDir)KIS Explorer.exe" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\media-types.json" LogicalName="SUTWinExplorer.MediaTypes.json" />
    <EmbeddedResource Include="Assets\running-app-open-methods.json" LogicalName="SUTWinExplorer.RunningAppOpenMethods.json" />
    <EmbeddedResource Include="Assets\shell-extension-blacklist.json" LogicalName="SUTWinExplorer.ShellExtensionBlacklist.json" />
    <EmbeddedResource Include="Assets\directory-menu-whitelist.json" LogicalName="SUTWinExplorer.DirectoryMenuWhitelist.json" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>

</Project>
