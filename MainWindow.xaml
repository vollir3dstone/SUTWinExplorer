<Window x:Class="SUTWinExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SUTWinExplorer"
        Title="KIS Explorer" Icon="Assets/app.ico" Height="900" Width="1500"
        MinHeight="520" MinWidth="820" Background="#F3F5F7">
    <Window.Resources>
        <Style x:Key="TabCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#8B1A10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="#F3F5F7" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                <Button x:Name="ConfigurationButton" Style="{StaticResource TabCloseButtonStyle}"
                        Width="24" Height="24" Margin="0,0,10,0" Click="ConfigurationButton_Click"
                        ToolTip="Configuration" AutomationProperties.Name="Configuration">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                </Button>
                <Button x:Name="UseCasesButton" Style="{StaticResource TabCloseButtonStyle}"
                        Width="24" Height="24" Margin="0,0,6,0" Click="UseCasesButton_Click"
                        ToolTip="Use cases" AutomationProperties.Name="Use cases">
                    <Image Width="24" Height="24" Source="/Assets/usecase 24.png" />
                </Button>
                <TextBlock x:Name="UseCaseNameLabel" Style="{StaticResource PathHeaderDisplayStyle}"
                           VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Height="24" Margin="6,0" Background="#D8DDE3" />
                <Button Grid.Column="2" Click="Back_Click" Padding="0" Margin="0,0,12,0"
                    Width="24" Height="24" UseLayoutRounding="True" SnapsToDevicePixels="True"
                    IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}"
                    ToolTip="Back" AutomationProperties.Name="Back">
                <Image Width="16" Height="16" SnapsToDevicePixels="True"
                       Source="/Assets/ic_fluent_arrow_left_16_regular.png" />
            </Button>
                <Button Grid.Column="3" Click="Forward_Click" Padding="0" Margin="0,0,12,0"
                    Width="24" Height="24" UseLayoutRounding="True" SnapsToDevicePixels="True"
                    IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}"
                    ToolTip="Forward" AutomationProperties.Name="Forward">
                <Image Width="16" Height="16" SnapsToDevicePixels="True"
                       Source="/Assets/ic_fluent_arrow_right_16_regular.png" />
            </Button>
                <Button Grid.Column="4" Click="Up_Click" Padding="0" Margin="0,0,12,0"
                    Width="24" Height="24" UseLayoutRounding="True" SnapsToDevicePixels="True"
                    IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}"
                    ToolTip="Up" AutomationProperties.Name="Up">
                <Image Width="16" Height="16" SnapsToDevicePixels="True"
                       Source="/Assets/ic_fluent_arrow_up_16_regular.png" />
            </Button>
                  <Border Grid.Column="5" Width="1" Height="24" Margin="6,0" Background="#D8DDE3" />
              <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="AddressClipboardPasteButton" Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                          Click="AddressClipboardPaste_Click" IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}"
                          ToolTip="Paste path and navigate" AutomationProperties.Name="Paste path and navigate">
                      <Control Width="14" Height="14" Template="{StaticResource ClipboardPasteIconTemplate}" />
                  </Button>
                  <Button x:Name="AddressClipboardCopyButton" Width="24" Height="24" Padding="0"
                          Click="AddressClipboardCopy_Click" IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}"
                          ToolTip="Copy path to clipboard" AutomationProperties.Name="Copy path to clipboard">
                      <Control Width="14" Height="14" Template="{StaticResource ClipboardCopyIconTemplate}" />
                  </Button>
              </StackPanel>
              <ComboBox Grid.Column="7" x:Name="AddressBox" IsEditable="True" IsTextSearchEnabled="False"
                      IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}"
                      StaysOpenOnEdit="True" DisplayMemberPath="DisplayPath" SelectedValuePath="TabIndex"
                      VerticalAlignment="Center" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"
                      SelectionChanged="AddressBox_SelectionChanged" Margin="6,0" />
            <Button Grid.Column="8" Content="Go" Click="Go_Click" Padding="12,4"
                    IsEnabled="{Binding IsVisible, ElementName=ExplorerTabs}" />
        </Grid>
        <Grid>
            <TabControl x:Name="ExplorerTabs" Padding="0" HorizontalContentAlignment="Stretch"
                        SelectionChanged="ExplorerTabs_SelectionChanged" />
            <local:UseCasesView x:Name="UseCasesPane" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
