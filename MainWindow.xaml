<Window x:Class="SUTWinExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SUT Win Explorer" Icon="Assets/app.ico" Height="760" Width="1180"
        MinHeight="520" MinWidth="820" Background="#F3F5F7">
    <Window.Resources>
        <Style x:Key="TabCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#8B1A10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="#F3F5F7" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Back" Click="Back_Click" Padding="10,4" />
            <Button Grid.Column="1" Content="Forward" Click="Forward_Click" Padding="10,4" />
            <Button Grid.Column="2" Content="Up" Click="Up_Click" Padding="10,4" />
            <Border Grid.Column="3" Width="1" Height="24" Margin="6,0" Background="#D8DDE3" />
            <ComboBox Grid.Column="4" x:Name="AddressBox" IsEditable="True" IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True" DisplayMemberPath="DisplayPath" SelectedValuePath="TabIndex"
                      VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"
                      SelectionChanged="AddressBox_SelectionChanged" Margin="6,0" />
            <Button Grid.Column="5" Content="Go" Click="Go_Click" Padding="12,4" />
        </Grid>
        <TabControl x:Name="ExplorerTabs" SelectionChanged="ExplorerTabs_SelectionChanged" />
    </DockPanel>
</Window>
