<UserControl x:Class="SUTWinExplorer.Pathview"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SUTWinExplorer">
    <UserControl.Resources>
        <x:Array x:Key="PaneColorPalette" Type="{x:Type SolidColorBrush}">
            <SolidColorBrush Color="#FFEC8F8F" />
            <SolidColorBrush Color="#FFFAB891" />
            <SolidColorBrush Color="#FFFDDF86" />
            <SolidColorBrush Color="#FFF5F5A1" />
            <SolidColorBrush Color="#FFBFEC8C" />
            <SolidColorBrush Color="#FF8FCF98" />
            <SolidColorBrush Color="#FF85E6FC" />
            <SolidColorBrush Color="#FF8ECCFF" />
            <SolidColorBrush Color="#FF85ADE9" />
            <SolidColorBrush Color="#FFBFB8FF" />
            <SolidColorBrush Color="#FFD995F3" />
            <SolidColorBrush Color="#FFFFADDE" />
        </x:Array>
        <DataTemplate x:Key="PaneColorSwatchTemplate">
            <Button Width="26" Height="26" Margin="3" Padding="2"
                    Background="{Binding}" BorderBrush="#A6A6A6"
                    Tag="{Binding}" ToolTip="Select this color"
                    AutomationProperties.Name="Set pane background color"
                    Click="PaneColorSwatch_Click" />
        </DataTemplate>
         <Style x:Key="ContentPaneButtonStyle" TargetType="{x:Type Button}"
             BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <DataTemplate x:Key="ShellIconTemplate">
            <Grid Width="16" Height="16" ClipToBounds="False"
                  Opacity="{Binding Icons.Opacity, TargetNullValue=1, FallbackValue=1}">
                <Image Width="16" Height="16" Source="{Binding Icons.BaseIcon}" Stretch="None" />
                  <Image Width="9" Height="9" Source="{Binding Icons.OverlayIcon}" Stretch="Uniform"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
        <Style x:Key="DirectoryTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock x:Name="ExpanderGlyph" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Foreground="#58636D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:TreeEntry}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <Style x:Key="DirectoryTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                          Style="{StaticResource DirectoryTreeExpanderStyle}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          />
                            <ContentPresenter Grid.Row="0" Grid.Column="1" Width="16" Height="16"
                                              Content="{Binding}" ContentTemplate="{StaticResource ShellIconTemplate}"
                                              VerticalAlignment="Center" />
                            <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="2" Padding="6,0,1,0"
                                    MinHeight="{x:Static local:Pathview.DirectoryTreeRowHeight}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasSubdirectories}" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNavigationPending}" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#E6E6E6" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#DCEBFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Expanded" Handler="TreeItem_Expanded" />
            <EventSetter Event="RequestBringIntoView" Handler="Tree_RequestBringIntoView" />
        </Style>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" MinHeight="36" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1"
                Margin="0,0,0,4" Background="{Binding PaneBackground, ElementName=Root}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LocationHeaderPanel" Grid.Column="0" Orientation="Horizontal"
                            Margin="0,2,0,2" SizeChanged="LocationHeaderPanel_SizeChanged">
                <Button x:Name="BrowsePathviewButton" Content="Browse" Style="{StaticResource ContentPaneButtonStyle}" Padding="10,1"
                        Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                        IsEnabled="False" Click="PathviewActionButton_Click" />
                <Button x:Name="PinPathviewButton" Content="Pin" Style="{StaticResource ContentPaneButtonStyle}" Padding="10,1"
                        Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                        IsEnabled="False" Click="PathviewActionButton_Click" />
                <Border x:Name="FixedPathBadge" Background="#E1E4E7" Padding="6,3"
                    Margin="10,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="FIXED" FontWeight="Bold" Foreground="#4E5963" />
                </Border>
                <TextBlock x:Name="LocationLabel" Style="{StaticResource PathHeaderDisplayStyle}"
                       Padding="12,2" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="PaneColorButton" Grid.Column="1" Width="28" Height="28" Padding="0"
                    Margin="8,0,0,0" ToolTip="Choose pane background color"
                        AutomationProperties.Name="Choose pane background color"
                        Click="PaneColorButton_Click">
                    <Image Width="16" Height="16" Source="/Assets/ic_fluent_color_32_regular.png" />
                </Button>
                <Popup x:Name="PaneColorPopup" PlacementTarget="{Binding ElementName=PaneColorButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#A6A6A6" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Pane color" FontWeight="SemiBold" Margin="2,0,2,6" />
                            <ItemsControl ItemsSource="{StaticResource PaneColorPalette}"
                                          ItemTemplate="{StaticResource PaneColorSwatchTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" x:Name="SidebarTabs" Background="White">
            <TabItem x:Name="ActivePathTab" Header="Active path">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Path"
                              BorderBrush="#A6A6A6" BorderThickness="1"
                              Margin="0,0,0,4" Padding="0">
                        <TreeView x:Name="ActivePathTree"
                                  ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}"
                                  BorderThickness="0" Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                                  PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp" />
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="Sub directories"
                              BorderBrush="#A6A6A6" BorderThickness="1"
                              Margin="0,4,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <local:CheckBoxWrapper x:Name="HideInternalSubfoldersCheckBox" Grid.Row="0"
                                                   Label="Hide internal" Margin="8,6,8,4" />
                                                <Border Grid.Row="1" BorderBrush="#646464" BorderThickness="0.7"
                                    Margin="10,0,10,0">
                                <ListView x:Name="ActivePathSubfoldersList"
                                          BorderThickness="0" Padding="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          PreviewMouseRightButtonDown="ActivePathSubfoldersList_PreviewMouseRightButtonDown"
                                          PreviewKeyDown="ActivePathSubfoldersList_PreviewKeyDown"
                                          PreviewMouseLeftButtonUp="ActivePathSubfoldersList_PreviewMouseLeftButtonUp">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Height"
                                                    Value="{x:Static local:Pathview.DirectoryTreeRowHeight}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <EventSetter Event="MouseEnter"
                                                         Handler="ActivePathSubfoldersListItem_MouseEnter" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="RowBackground" Background="Transparent">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBackground" Property="Background" Value="#DCEBFA" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBackground" Property="Background" Value="#DCEBFA" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{x:Static local:Pathview.DirectoryTreeRowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Width="16" Height="16"
                                                                  Content="{Binding}"
                                                                  ContentTemplate="{StaticResource ShellIconTemplate}"
                                                                  VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0,2,0"
                                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="ActivePathAndSiblingsTab" Header="Active path and siblings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <CheckBox x:Name="HideSiblingsCheckBox" Content="Hide siblings"
                                  IsChecked="False" Margin="8,6,8,4"
                                  Checked="HideSiblingsCheckBox_StateChanged"
                                  Unchecked="HideSiblingsCheckBox_StateChanged" />
                        <CheckBox x:Name="HideInternalCheckBox" Content="Hide internal"
                                  IsChecked="False" Margin="8,6,8,4"
                                  Checked="HideInternalCheckBox_StateChanged"
                                  Unchecked="HideInternalCheckBox_StateChanged" />
                    </StackPanel>
                    <TreeView x:Name="ActivePathAndSiblingsTree" Grid.Row="1"
                              ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                              MouseDoubleClick="Tree_MouseDoubleClick" />
                </Grid>
            </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DDE3" />
            <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="10,0,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="24" Background="#E1E4E7" Padding="6,0"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="VIEW:" FontWeight="Bold" Foreground="#4E5963"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" TextWrapping="NoWrap">
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:CheckBoxWrapper x:Name="HideDirectoriesCheckBox"
                                                   Label="Hide directories" Margin="0,0,16,0" />
                        </InlineUIContainer>
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <local:CheckBoxWrapper x:Name="HideInternalContentCheckBox"
                                                   Label="Hide internal" Margin="0,0,16,0" />
                        </InlineUIContainer>
                        <Run Text="Name pattern  " />
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <Border Width="172" Height="24"
                                    local:InputChrome.BaselineSource="{Binding ElementName=NamePatternTextBox}"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{StaticResource Input.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource InputCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NamePatternTextBox" Grid.Column="0" Padding="3,0"
                                             local:InputChrome.CornerRadius="3,0,0,3"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Use * and ? as wildcards"
                                             TextChanged="NamePatternTextBox_TextChanged" />
                                    <Button Grid.Column="1" Content="×" Style="{StaticResource ContentPaneButtonStyle}"
                                            Width="20" Height="22" Padding="0"
                                            local:InputChrome.CornerRadius="0,3,3,0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="Clear name pattern" Click="ClearNamePatternButton_Click" />
                                </Grid>
                            </Border>
                        </InlineUIContainer>
                    </TextBlock>
                </Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#E1E4E7" Padding="6,3" Margin="0,0,8,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="SELECTED:" FontWeight="Bold" Foreground="#4E5963" />
                </Border>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RenameButton" Content="Rename" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Rename" ToolTip="Rename"
                            Tag="Rename" Width="72" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="PathGetButton" Content="Path🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Path get" ToolTip="Path get"
                            Tag="PathGet" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="CopyGetButton" Content="Copy🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy get" ToolTip="Copy get"
                            Tag="CopyGet" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="CopyAbortButton" Content="Copy✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy abort" ToolTip="Copy abort"
                            Tag="CopyAbort" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="CopyPasteButton" Content="Copy🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Copy paste" ToolTip="Copy paste"
                            Tag="CopyPaste" Width="48" Padding="0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                        <Button x:Name="MoveGetButton" Content="Move🠝" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move get" ToolTip="Move get"
                            Tag="MoveGet" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="MoveAbortButton" Content="Move✕" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move abort" ToolTip="Move abort"
                            Tag="MoveAbort" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                        <Button x:Name="MovePasteButton" Content="Move🠟" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Move paste" ToolTip="Move paste"
                            Tag="MovePaste" Width="48" Padding="0" IsEnabled="False"
                            Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="9" Orientation="Horizontal">
                        <Button x:Name="DeleteButton" Content="Del🗑️" Style="{StaticResource ContentPaneButtonStyle}" AutomationProperties.Name="Delete" ToolTip="Delete"
                            Tag="Delete" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ListView x:Name="FileList" Grid.Row="2" Grid.Column="0" SelectionMode="Single"
                      SelectionChanged="FileList_SelectionChanged" SizeChanged="FileList_SizeChanged"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      PreviewKeyDown="FileList_PreviewKeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="34">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellIconTemplate}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name" Width="330" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Type}" />
                        <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Date modified" Width="170" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <ContentControl x:Name="ShellBrowserSlot" Grid.Row="2" Grid.Column="0" Visibility="Collapsed"
                            SizeChanged="ShellBrowserSlot_SizeChanged" />
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E4E8" BorderThickness="1,0,0,0"
                    Background="#F6F7F8" VerticalAlignment="Stretch">
                <TextBlock x:Name="StatusLabel" Padding="8,6" Foreground="#596675"
                           VerticalAlignment="Top" HorizontalAlignment="Center" />
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>