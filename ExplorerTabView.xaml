<UserControl x:Class="SUTWinExplorer.Pathview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SUTWinExplorer">
    <UserControl.Resources>
        <DataTemplate x:Key="ShellIconTemplate">
            <Grid Width="16" Height="16" ClipToBounds="False"
                  Opacity="{Binding Icons.Opacity, TargetNullValue=1, FallbackValue=1}">
                <Image Width="16" Height="16" Source="{Binding Icons.BaseIcon}" Stretch="None" />
                  <Image Width="9" Height="9" Source="{Binding Icons.OverlayIcon}" Stretch="Uniform"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
        <Style x:Key="DirectoryTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock x:Name="ExpanderGlyph" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Foreground="#58636D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:TreeEntry}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <Style x:Key="DirectoryTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                          Style="{StaticResource DirectoryTreeExpanderStyle}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          />
                            <ContentPresenter Grid.Row="0" Grid.Column="1" Width="16" Height="16"
                                              Content="{Binding}" ContentTemplate="{StaticResource ShellIconTemplate}"
                                              VerticalAlignment="Center" />
                            <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="2" Padding="6,0,1,0"
                                    MinHeight="{x:Static local:Pathview.DirectoryTreeRowHeight}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasSubdirectories}" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#DCEBFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Expanded" Handler="TreeItem_Expanded" />
        </Style>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="210" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TabControl Grid.Column="0" x:Name="SidebarTabs" Background="White">
            <TabItem x:Name="ActivePathTab" Header="Active path">
                <TreeView x:Name="ActivePathTree" ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                          PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                          MouseDoubleClick="Tree_MouseDoubleClick" />
            </TabItem>
            <TabItem x:Name="ActivePathAndSiblingsTab" Header="Active path and siblings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="HideInternalCheckBox" Grid.Row="0" Content="Hide internal"
                              IsChecked="False" Margin="8,6,8,4"
                              Checked="HideInternalCheckBox_StateChanged"
                              Unchecked="HideInternalCheckBox_StateChanged" />
                    <TreeView x:Name="ActivePathAndSiblingsTree" Grid.Row="1"
                              ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                              MouseDoubleClick="Tree_MouseDoubleClick" />
                </Grid>
            </TabItem>
        </TabControl>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DDE3" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LocationHeaderPanel" Grid.Row="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" SizeChanged="LocationHeaderPanel_SizeChanged">
                <Border x:Name="FixedPathBadge" Background="#E1E4E7" Padding="6,3"
                        Margin="10,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="FIXED" FontWeight="Bold" Foreground="#4E5963" />
                </Border>
                <TextBlock x:Name="LocationLabel" Padding="12,10" FontSize="14"
                           FontWeight="SemiBold" Foreground="#263443" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button x:Name="BrowsePathviewButton" Content="Browse" Padding="10,1"
                        Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                        IsEnabled="False" Click="PathviewActionButton_Click" />
                <Button x:Name="PinPathviewButton" Content="Pin" Padding="10,1"
                    Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                    IsEnabled="False" Click="PathviewActionButton_Click" />
            </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,0,10,8">
                    <Border Background="#E1E4E7" Padding="6,3" Margin="0,0,8,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="VIEW:" FontWeight="Bold" Foreground="#4E5963" />
                    </Border>
                    <CheckBox x:Name="HideDirectoriesCheckBox" Content="Hide directories"
                              IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                              Checked="HideDirectoriesCheckBox_StateChanged"
                              Unchecked="HideDirectoriesCheckBox_StateChanged" />
                    <CheckBox x:Name="HideInternalContentCheckBox" Content="Hide internal"
                              IsChecked="True" VerticalAlignment="Center"
                              Checked="HideInternalContentCheckBox_StateChanged"
                              Unchecked="HideInternalContentCheckBox_StateChanged" />
                </StackPanel>
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#E1E4E7" Padding="6,3" Margin="0,0,8,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="SELECTED:" FontWeight="Bold" Foreground="#4E5963" />
                </Border>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RenameButton" Content="Rename" AutomationProperties.Name="Rename" ToolTip="Rename"
                            Tag="Rename" Width="72" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="PathGetButton" Content="Path🠝" AutomationProperties.Name="Path get" ToolTip="Path get"
                            Tag="PathGet" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="CopyGetButton" Content="Copy🠝" AutomationProperties.Name="Copy get" ToolTip="Copy get"
                            Tag="CopyGet" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False" />
                        <Button Content="Copy❌" AutomationProperties.Name="Copy abort" ToolTip="Copy abort"
                            Tag="CopyAbort" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False" />
                        <Button x:Name="CopyPasteButton" Content="Copy🠟" AutomationProperties.Name="Copy paste" ToolTip="Copy paste"
                            Tag="CopyPaste" Width="48" Padding="0" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                        <Button x:Name="MoveGetButton" Content="Move🠝" AutomationProperties.Name="Move get" ToolTip="Move get"
                            Tag="MoveGet" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False" />
                        <Button x:Name="MoveAbortButton" Content="Move❌" AutomationProperties.Name="Move abort" ToolTip="Move abort"
                            Tag="MoveAbort" Width="48" Padding="0" Margin="0,0,4,0" IsEnabled="False" />
                        <Button x:Name="MovePasteButton" Content="Move🠟" AutomationProperties.Name="Move paste" ToolTip="Move paste"
                            Tag="MovePaste" Width="48" Padding="0" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="9" Orientation="Horizontal">
                        <Button x:Name="DeleteButton" Content="Del🗑️" AutomationProperties.Name="Delete" ToolTip="Delete"
                            Tag="Delete" Width="48" Padding="0" IsEnabled="False"
                                Click="ContentOperationButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ListView x:Name="FileList" Grid.Row="3" Grid.Column="0" SelectionMode="Single"
                      SelectionChanged="FileList_SelectionChanged" SizeChanged="FileList_SizeChanged"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      PreviewKeyDown="FileList_PreviewKeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="34">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellIconTemplate}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name" Width="330" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Type}" />
                        <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Date modified" Width="170" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <ContentControl x:Name="ShellBrowserSlot" Grid.Row="3" Grid.Column="0" Visibility="Collapsed"
                            SizeChanged="ShellBrowserSlot_SizeChanged" />
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E4E8" BorderThickness="1,0,0,0"
                    Background="#F6F7F8" VerticalAlignment="Stretch">
                <TextBlock x:Name="StatusLabel" Padding="8,6" Foreground="#596675"
                           VerticalAlignment="Top" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>