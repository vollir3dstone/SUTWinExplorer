<UserControl x:Class="SUTWinExplorer.Pathview"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SUTWinExplorer">
    <UserControl.Resources>
        <x:Array x:Key="PaneColorPalette" Type="{x:Type SolidColorBrush}">
            <SolidColorBrush Color="#FFEC8F8F" />
            <SolidColorBrush Color="#FFFAB891" />
            <SolidColorBrush Color="#FFFDDF86" />
            <SolidColorBrush Color="#FFF5F5A1" />
            <SolidColorBrush Color="#FFBFEC8C" />
            <SolidColorBrush Color="#FF8FCF98" />
            <SolidColorBrush Color="#FF85E6FC" />
            <SolidColorBrush Color="#FF8ECCFF" />
            <SolidColorBrush Color="#FF85ADE9" />
            <SolidColorBrush Color="#FFBFB8FF" />
            <SolidColorBrush Color="#FFD995F3" />
            <SolidColorBrush Color="#FFFFADDE" />
        </x:Array>
        <DataTemplate x:Key="PaneColorSwatchTemplate">
            <Button Width="26" Height="26" Margin="3" Padding="2"
                    Background="{Binding}" BorderBrush="#A6A6A6"
                    Tag="{Binding}" ToolTip="Select this color"
                    AutomationProperties.Name="Set pane background color"
                    Click="PaneColorSwatch_Click" />
        </DataTemplate>
        <Style x:Key="HeaderLineGroupBoxStyle" TargetType="{x:Type GroupBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="1" Background="{StaticResource ViewFrameBrush}"
                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center"
                                                  TextElement.Foreground="#4E5963"
                                                  TextElement.FontWeight="SemiBold" />
                                <Border Grid.Column="2" Height="1" Background="{StaticResource ViewFrameBrush}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter Grid.Row="1" ContentSource="Content"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DirectoryTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock x:Name="ExpanderGlyph" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Foreground="#58636D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:TreeEntry}" ItemsSource="{Binding Children}">
            <Grid>
                <TextBlock x:Name="TreeName" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBox x:Name="TreeNameEditor" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed" Padding="1,0" MinWidth="80"
                         IsVisibleChanged="TreeNameEditor_IsVisibleChanged" KeyDown="TreeNameEditor_KeyDown"
                         LostKeyboardFocus="TreeNameEditor_LostKeyboardFocus" />
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TreeName" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TreeNameEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <Style x:Key="DirectoryTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderRow" Grid.Row="0" Grid.ColumnSpan="3" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="HeaderBorder" Grid.ColumnSpan="3" IsHitTestVisible="False" />
                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Style="{StaticResource DirectoryTreeExpanderStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <ContentPresenter Grid.Column="1" Width="16" Height="16"
                                                  Content="{Binding}" ContentTemplate="{StaticResource ShellIconTemplate}"
                                                  VerticalAlignment="Center" />
                                <Border Grid.Column="2" Padding="6,0,1,0"
                                        MinHeight="{x:Static local:Pathview.DirectoryTreeRowHeight}">
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasSubdirectories}" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger SourceName="HeaderRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsNavigationPending}" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ItemRequestBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ItemSelectionBrush}" />
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource ItemSelectionBorderBrush}" />
                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Expanded" Handler="TreeItem_Expanded" />
            <EventSetter Event="RequestBringIntoView" Handler="Tree_RequestBringIntoView" />
        </Style>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" MinHeight="36" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1"
                Margin="0,0,0,4" Background="{Binding PaneBackground, ElementName=Root}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="LocationHeaderPanel" Grid.Column="0" Margin="0,2,0,2"
                      SizeChanged="LocationHeaderPanel_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition x:Name="LocationHeaderGap" Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                      <Grid x:Name="LocationHeaderPrefix" Grid.Column="0"
                          SizeChanged="LocationHeaderPanel_SizeChanged">
                        <TextBlock Text="000000000000000000000000000000"
                                   Visibility="Hidden" IsHitTestVisible="False" TextWrapping="NoWrap"
                                   FontFamily="{Binding FontFamily, ElementName=LocationLabel}"
                                   FontSize="{Binding FontSize, ElementName=LocationLabel}"
                                   FontWeight="{Binding FontWeight, ElementName=LocationLabel}"
                                   FontStyle="{Binding FontStyle, ElementName=LocationLabel}"
                                   FontStretch="{Binding FontStretch, ElementName=LocationLabel}" />
                            <Grid Background="#4D000000" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowsePathviewButton" Grid.Column="0" Content="Browse"
                                    Style="{StaticResource ContentPaneButtonStyle}" Padding="10,1"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    IsEnabled="False" Click="PathviewActionButton_Click" />
                                <Button x:Name="PinPathviewButton" Grid.Column="0" Content="Pin"
                                    Style="{StaticResource ContentPaneButtonStyle}" Padding="10,1"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    IsEnabled="False" Click="PathviewActionButton_Click" />
                                <Button x:Name="OpenInExplorerButton" Grid.Column="2" Width="28"
                                    Height="{StaticResource ContentPaneControlHeight}" Padding="0" VerticalAlignment="Center"
                                    ToolTip="Open in Windows Explorer"
                                    AutomationProperties.Name="Open current path in a new Windows Explorer window"
                                    IsEnabled="False" Click="OpenInExplorerButton_Click">
                                    <Image x:Name="OpenInExplorerIcon" Width="16" Height="16" Stretch="Uniform" />
                                </Button>
                                <Border x:Name="FixedPathBadge" Grid.Column="4" Style="{StaticResource BadgeStyle}"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="FIXED" FontWeight="Bold" Foreground="#4E5963" VerticalAlignment="Center" />
                            </Border>
                            </Grid>
                    </Grid>
                    <Grid x:Name="LocationDisplay" Grid.Column="2" Background="Transparent"
                          ToolTipService.Placement="Bottom" ToolTipService.PlacementTarget="{Binding ElementName=LocationLabel}"
                          ToolTipService.InitialShowDelay="200" ToolTipOpening="LocationLabel_ToolTipOpening"
                          ToolTipClosing="LocationLabel_ToolTipClosing" MouseLeave="LocationLabel_MouseLeave">
                        <Grid.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" />
                            </ToolTip>
                        </Grid.ToolTip>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="LocationIconSlot" Grid.Column="0" Width="24" Height="24" Margin="0,0,2,0"
                              VerticalAlignment="Center">
                            <Image x:Name="LocationBaseIcon" Width="24" Height="24" Stretch="Uniform" />
                            <Image x:Name="LocationOverlayIcon" Width="13" Height="13" Stretch="Uniform"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="LocationLabel" Grid.Column="1" Style="{StaticResource PathHeaderDisplayStyle}"
                                   Padding="2,2" Background="Transparent" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EditCustomNameButton" Width="28" Height="28" Padding="0"
                                ToolTip="Edit custom Pathview name"
                                AutomationProperties.Name="Edit custom Pathview name"
                                Visibility="Collapsed" Click="EditCustomNameButton_Click">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="PaneColorButton" Width="28" Height="28" Padding="0"
                                ToolTip="Choose pane background color"
                                AutomationProperties.Name="Choose pane background color"
                                Click="PaneColorButton_Click">
                            <Image Width="16" Height="16" Source="/Assets/ic_fluent_color_32_regular.png" />
                        </Button>
                    </StackPanel>
                        <Button x:Name="MoveMarkCurrentDirectoryButton" Content="Move🠝"
                            Style="{StaticResource ContentPaneButtonStyle}" Width="48" Padding="0"
                            Margin="4,0,0,0" IsEnabled="False" ToolTip="Move mark item"
                            AutomationProperties.Name="Move mark item" Click="MoveMarkCurrentDirectoryButton_Click" />
                        <Button x:Name="RenameCurrentDirectoryButton" Content="Rename..."
                            Style="{StaticResource ContentPaneButtonStyle}" Padding="10,1"
                            Margin="4,0,0,0" IsEnabled="False" Click="RenameCurrentDirectoryButton_Click" />
                        <Button x:Name="RelocateCurrentDirectoryButton" Content="Relocate..."
                            Style="{StaticResource ContentPaneButtonStyle}" Padding="10,1"
                            Margin="4,0,0,0" IsEnabled="False" Click="RelocateCurrentDirectoryButton_Click" />
                </StackPanel>
                <Popup x:Name="PaneColorPopup" PlacementTarget="{Binding ElementName=PaneColorButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#A6A6A6" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Pane color" FontWeight="SemiBold" Margin="2,0,2,6" />
                            <ItemsControl ItemsSource="{StaticResource PaneColorPalette}"
                                          ItemTemplate="{StaticResource PaneColorSwatchTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" x:Name="SidebarTabs" Background="White" Margin="0,0,4,0">
            <TabItem x:Name="ActivePathTab" Header="Active path">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Path"
                              Style="{StaticResource HeaderLineGroupBoxStyle}"
                              Margin="0,0,0,4" Padding="0">
                        <Border BorderBrush="{StaticResource ViewFrameBrush}"
                            BorderThickness="{StaticResource ViewFrameThickness}">
                            <TreeView x:Name="ActivePathTree"
                                      ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}"
                                      BorderThickness="0" Padding="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp" />
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="Sub directories"
                              Style="{StaticResource HeaderLineGroupBoxStyle}"
                              Margin="0,4,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource BadgeStyle}"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="VIEW:" FontWeight="Bold" Foreground="#4E5963"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="NoWrap">
                                    <InlineUIContainer BaselineAlignment="Baseline">
                                        <local:CheckBoxWrapper x:Name="HideInternalSubdirectoriesCheckBox"
                                                               Label="Hide internal" Margin="0,0,16,0" />
                                    </InlineUIContainer>
                                </TextBlock>
                            </Grid>
                                <Border Grid.Row="2" BorderBrush="{StaticResource ViewFrameBrush}"
                                    BorderThickness="{StaticResource ViewFrameThickness}"
                                    Margin="0">
                                <ListView x:Name="ActivePathSubdirectoriesList"
                                          BorderThickness="0" Padding="0" Margin="16,0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          PreviewMouseRightButtonDown="ActivePathSubdirectoriesList_PreviewMouseRightButtonDown"
                                          PreviewKeyDown="ActivePathSubdirectoriesList_PreviewKeyDown"
                                          PreviewMouseLeftButtonDown="ActivePathSubdirectoriesList_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="ActivePathSubdirectoriesList_PreviewMouseLeftButtonUp">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Height"
                                                    Value="{x:Static local:Pathview.DirectoryTreeRowHeight}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <EventSetter Event="MouseEnter"
                                                         Handler="ActivePathSubdirectoriesListItem_MouseEnter" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Grid Background="Transparent">
                                                            <Border x:Name="RowBackground" IsHitTestVisible="False" />
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource ItemSelectionBrush}" />
                                                                <Setter TargetName="RowBackground" Property="BorderBrush" Value="{StaticResource ItemSelectionBorderBrush}" />
                                                                <Setter TargetName="RowBackground" Property="BorderThickness" Value="1" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{x:Static local:Pathview.DirectoryTreeRowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Width="16" Height="16"
                                                                  Content="{Binding}"
                                                                  ContentTemplate="{StaticResource ShellIconTemplate}"
                                                                  VerticalAlignment="Center" />
                                                <TextBlock x:Name="SubdirectoryName" Grid.Column="1" Text="{Binding Name}" Margin="4,0,2,0"
                                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBox x:Name="SubdirectoryNameEditor" Grid.Column="1" Margin="4,0,2,0"
                                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="Collapsed" Padding="1,0"
                                                         IsVisibleChanged="TreeNameEditor_IsVisibleChanged"
                                                         KeyDown="TreeNameEditor_KeyDown"
                                                         LostKeyboardFocus="TreeNameEditor_LostKeyboardFocus" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter TargetName="SubdirectoryName" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="SubdirectoryNameEditor" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="ActivePathAndSiblingsTab" Header="Active path and siblings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,4,0">
                        <Border Style="{StaticResource BadgeStyle}"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="VIEW:" FontWeight="Bold" Foreground="#4E5963"
                                       VerticalAlignment="Center" />
                        </Border>
                        <CheckBox x:Name="HideSiblingsCheckBox" Content="Hide siblings"
                                  IsChecked="True" Margin="0,6,8,4"
                                  Checked="HideSiblingsCheckBox_StateChanged"
                                  Unchecked="HideSiblingsCheckBox_StateChanged" />
                        <CheckBox x:Name="HideInternalCheckBox" Content="Hide internal"
                                  IsChecked="True" Margin="8,6,8,4"
                                  Checked="HideInternalCheckBox_StateChanged"
                                  Unchecked="HideInternalCheckBox_StateChanged" />
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="{StaticResource ViewFrameBrush}"
                            BorderThickness="{StaticResource ViewFrameThickness}" Margin="4,0,4,0">
                        <TreeView x:Name="ActivePathAndSiblingsTree"
                                  BorderThickness="0" Padding="0"
                                  ItemContainerStyle="{StaticResource DirectoryTreeItemStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                                  PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                                  MouseDoubleClick="Tree_MouseDoubleClick" />
                    </Border>
                </Grid>
            </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DDE3" />
            <local:ContentView x:Name="DirectoryContent" Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>